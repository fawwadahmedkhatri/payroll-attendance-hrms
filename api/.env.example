# Copy to .env and adjust for local development (without Docker for the API)
DATABASE_URL=postgresql://hrms:hrms_local_pw@localhost:5433/hrms?schema=public
JWT_SECRET=replace-with-a-long-random-string
PORT=4000
# Origin of the web app (only needed if you call the API directly from the browser)
CORS_ORIGIN=http://localhost:3000
